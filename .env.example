# Claude Quota Monitor - Environment Configuration Example

# Secret key required for authentication (?key=..., x-api-key header, or Bearer token)
QUOTA_AUTH_KEY=your-secure-secret-key-here

# Server configuration (standalone Node.js / Docker)
PORT=8799
HOST=0.0.0.0
DATA_DIR=./data

# Optional machine and account labels
# MACHINE_LABELS='{"m-01":"Dev M3 Max","m-02":"Mac Studio"}'
# ACCOUNT_LABELS='{"primary@example.com":"Primary Work","backup@example.com":"Personal Team"}'

# Local development seed mode (set to 1 to enable /__dev/seed)
# DEV_SEED=0
